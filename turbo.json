{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["PERRY_TARGET", "VITE_PERRY_TARGET"],
  "globalPassThroughEnv": ["SURREAL_PASS", "BETTER_AUTH_SECRET"],
  "boundaries": {
    "tags": {
      "contracts": {
        "dependencies": {
          "deny": ["seam", "infra"]
        }
      }
    }
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NODE_ENV",
        "SURREAL_URL",
        "SURREAL_NS",
        "SURREAL_DB",
        "SURREAL_USER",
        "BETTER_AUTH_URL",
        "CORS_ORIGIN"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "cache": false
    },
    "destroy": {
      "cache": false
    }
  }
}
